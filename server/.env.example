# 复制为 .env 并按需修改
ENV=prod
PORT=8080
DB_DRIVER=mysql
DB_DSN=quant:change-me-quant@tcp(mysql:3306)/quant_server
JWT_SECRET=请替换为随机长密钥（openssl rand -hex 32）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请设置初始管理员密码
SMS_MODE=mock

# 阿里云短信（可选，SMS_MODE=aliyun 时必填）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SIGN_NAME=
ALIYUN_TEMPLATE_CODE=

# MySQL 容器初始化
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-quant
